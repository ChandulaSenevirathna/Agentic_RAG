# Copy this file to .env and fill in your own keys.
# Never commit your real .env file.

# Groq — used by all three notebooks as the LLM provider.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Tavily — used by 2_Corrective_RAG.ipynb and 3_Adaptive_RAG.ipynb for web search.
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=

# Optional, not required by the notebooks as shipped.
GOOGLE_API_KEY=
